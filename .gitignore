# Build outputs
/dist/
*.exe
*.dll

# cmd/installer's embedded payload, populated by stagebuild per app build
# (go:embed requires at least one committed file to exist, hence the
# placeholder exception — see cmd/installer/payload/PLACEHOLDER.txt)
/cmd/installer/payload/*
!/cmd/installer/payload/PLACEHOLDER.txt

# Downloaded/cached JRE archives and Java build artifacts used for local dev testing
/examples/**/*.zip
/examples/abc/java/target/
/examples/abc/java/*.class

# generated by examples/abc/prepare-stagebuild-fixtures.ps1: placeholder-
# substituted copies of the appconfig/manifest templates, resolved against
# the local JAVA_HOME (machine-specific, regenerate as needed)
/examples/abc/manifest.generated.json
/examples/abc/appconfig.generated.json

# generated by examples/abc/setup-dev-install.ps1: manifest.json with
# runtime.javaVersion/path substituted for the locally detected JDK,
# actually served by fakeserver (the test install root itself lives outside
# the repo, under %LocalAppData%\ABC)
/examples/abc/fakeserver/served/

# Throwaway harness to preview internal/tui's wizard styling interactively
# without a real cmd/installer run — local dev tool, not shipped, kept on
# disk but deliberately never committed
/cmd/tuidemo/

# Editor/OS cruft
.vscode/
.idea/
Thumbs.db
